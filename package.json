{
  "name": "nexus-ptw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:integration": "tsx tests/api.integration.ts",
    "notifications:work": "node --env-file-if-exists=.env.local --import tsx scripts/notifications.ts",
    "db:setup": "node --env-file=.env.local scripts/setup.mjs",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.1.12"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "fake-indexeddb": "^6.2.8",
    "gts": "7.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3"
  }
}
