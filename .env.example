DATABASE_URL=postgresql://nexus:CHANGE_ME@localhost:5432/nexus
APP_URL=http://localhost:3000
COOKIE_SECURE=false
# Configurados apenas para criar o primeiro acesso; não há senha padrão.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_UNIT=Unidade piloto
# 32 bytes em hexadecimal (64 caracteres). Preserve a chave para abrir as credenciais já salvas.
INTEGRATIONS_ENCRYPTION_KEY=
# Origens HTTPS autorizadas pelo operador do servidor, separadas por vírgula.
OPENWA_ALLOWED_ORIGINS=
# URL inicial sugerida na tela, sem chave de API.
OPENWA_DEFAULT_URL=
